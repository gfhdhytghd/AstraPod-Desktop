[Unit]
Description=Apple Remote Menu to PodBox USB EP0
After=default.target

[Service]
WorkingDirectory=%h/.local/share/astrapod/desktop
ExecStart=%h/.local/share/astrapod/desktop/.venv/bin/python usb_remote_key/usb_remote_key.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
